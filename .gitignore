# Gold outputs (large files — don't commit)
gold/
*.csv.bak

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# MinIO local data (docker volume)
minio_data/
