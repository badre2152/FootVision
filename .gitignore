# Football DSS — .gitignore

# Environment
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
env/
.venv/

# Logs
logs/*.log
!logs/.gitkeep

# Gold outputs (large files — don't commit)
gold/
*.csv.bak

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# MinIO local data (docker volume)
minio_data/

# Streamlit secrets — real APP_PASSWORD lives only here, never committed
# (spec #6, 06_authentication.md). .streamlit/secrets.toml.example stays
# tracked as the template.
.streamlit/secrets.toml