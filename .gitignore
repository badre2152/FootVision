# Football DSS — .gitignore

# Environment
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
env/
.venv/

# Pipeline outputs (Bronze/Silver/Gold) — always regeneratable via
# `make bronze` / `make silver` / `make gold`. Never commit generated
# data artifacts, regardless of layer — this used to be inconsistent
# (only gold/ was ignored while bronze/ and silver/ were committed,
# ~52 tracked artifact files / 17MB of duplicate timestamped CSV+parquet
# pairs). See docs/architecture.md.
/bronze/
/silver/
/gold/
!/bronze/.gitkeep
!/silver/.gitkeep
!/gold/.gitkeep

# Logs
logs/*.log
!logs/.gitkeep

*.csv.bak

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# MinIO local data (docker volume)
minio_data/

# spec #6 — never commit the real shared password
.streamlit/secrets.toml